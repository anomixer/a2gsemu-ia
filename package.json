{
  "name": "a2gsemu-ia",
  "version": "1.0.0",
  "description": "Apple IIgs Emulator with Archive.org integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "tsc",
    "expand-games": "ts-node expand-games.ts",
    "expand-games:help": "ts-node expand-games.ts --help",
    "expand-games:status": "ts-node expand-games.ts --status",
    "expand-games:reset": "ts-node expand-games.ts --reset",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "apple2gs",
    "emulator",
    "mame",
    "archive.org"
  ],
  "author": "anomixer",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "node-fetch": "^2.7.0",
    "compression": "^1.7.4",
    "adm-zip": "^0.5.10"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.0",
    "@types/jest": "^29.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "fast-check": "^3.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
